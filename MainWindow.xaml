    mc:Ignorable="d"
    WindowStyle="None"
    WindowState="Maximized"
    Title="MainWindow" Height="450" Width="800">

    <WindowChrome.WindowChrome>
        <!--隐藏边框-->
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 加载图片资源 -->
        <BitmapImage x:Key="OnImage" UriSource="Resources/蓝色阀门.png"/>
        <BitmapImage x:Key="OffImage" UriSource="Resources/白色阀门.png"/>
    </Window.Resources>
    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Grid Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 标题行 -->
                <RowDefinition Height="*"/>
                <!-- 内容区域 -->
            </Grid.RowDefinitions>

            <!-- 主背景：珍珠白径向渐变 -->
            <Rectangle Grid.RowSpan="2" Panel.ZIndex="0"
           Fill="{StaticResource MainBackgroundBrush}"/>

            <!-- 背景点阵纹理（工程图纸技术感）-->
            <Rectangle Grid.RowSpan="2" Panel.ZIndex="1"
           IsHitTestVisible="False"
           Fill="{StaticResource ScanLineBrush}"
           Opacity="1"/>

            <Image Grid.RowSpan="2" Panel.ZIndex="0" Stretch="UniformToFill" Source="Resources/Top and bottom frame.png" Width="800" Height="450" Opacity="0" Margin="4,4,-4,-4"/>

            <!-- ═══════════════════════════════════════
                 标题栏：专业工业白 + 蓝钢顶线 + 3D深度
            ════════════════════════════════════════ -->
            <Border Height="44" VerticalAlignment="Top"
                    Background="{StaticResource TitleBarBrush}"
                    Effect="{StaticResource CardDropShadow}">
                <Grid>

                    <!-- 顶部蓝钢色高光线（3mm） -->
                    <Border Height="3" VerticalAlignment="Top"
                            Background="{StaticResource TitleTopHighlightBrush}"/>

                    <!-- 底部分割线（细灰） -->
                    <Border Height="1" VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C0CCD8" Offset="0"/>
                                <GradientStop Color="#60C0CCD8" Offset="0.2"/>
                                <GradientStop Color="#80C0CCD8" Offset="0.5"/>
                                <GradientStop Color="#60C0CCD8" Offset="0.8"/>
                                <GradientStop Color="#00C0CCD8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 左侧：公司英文名（小字，专业感） -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="14,4,0,4">
                        <TextBlock Text="JIANGSU CRRC YUNHUI TECHNOLOGY"
                                   FontSize="7" FontWeight="Normal"
                                   Foreground="#7090B0"/>
                        <TextBlock Text="分子筛转轮 · 动态测试系统"
                                   FontSize="8" FontWeight="Normal"
                                   Foreground="#4A6A8A" Margin="0,1,0,0"/>
