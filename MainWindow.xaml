                                   HorizontalAlignment="Right"
                                   Foreground="#7090B0"/>
                        <TextBlock Text="Zeolite Rotor System"
                                   FontSize="7" FontWeight="Normal"
                                   HorizontalAlignment="Right"
                                   Foreground="#90A8C0" Margin="0,1,0,0"/>
