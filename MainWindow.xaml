                    <!-- 居中：主标题 -->
                    <TextBlock Text="分子筛转轮动态测试系统看板"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#1A2A4A">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#A0B8D0" BlurRadius="4"
                                              ShadowDepth="1" Opacity="0.25"/>
