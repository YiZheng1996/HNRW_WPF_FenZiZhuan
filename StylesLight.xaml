<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ═══════════════════════════════════════════════════════════
      分子筛转轮动态测试系统  —  浅色工业风样式库
      文件：StylesLight.xaml
      说明：纯外观样式，不改变任何功能逻辑与数据绑定
            替换 Styles3D.xaml，所有 x:Key 保持一致
      使用：在 App.xaml 的 MergedDictionaries 中将
            Source="Styles3D.xaml" 改为 Source="StylesLight.xaml"
    ═══════════════════════════════════════════════════════════
    -->

    <!-- ══════════════════════════════════════════
         【公共画刷资源】统一色彩体系
         浅色工业风：浅灰白背景、金属银灰管道、柔和投影
    ══════════════════════════════════════════ -->

    <!-- 主背景：浅灰白径向渐变（中心略亮、边缘略暗） -->
    <RadialGradientBrush x:Key="MainBackgroundBrush" GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#FFF5F6F8" Offset="0"/>
        <GradientStop Color="#FFECEEF2" Offset="0.5"/>
        <GradientStop Color="#FFE4E6EB" Offset="1"/>
    </RadialGradientBrush>

    <!-- 管道槽：浅灰凹槽底色 -->
    <LinearGradientBrush x:Key="PipeSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD0D4DA" Offset="0"/>
        <GradientStop Color="#FFC0C6CE" Offset="0.5"/>
        <GradientStop Color="#FFD0D4DA" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道3D渐变：金属银灰圆管截面光感 -->
    <LinearGradientBrush x:Key="Pipe3DBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFB8BEC6" Offset="0"/>
        <GradientStop Color="#FFE8EAEE" Offset="0.22"/>
        <GradientStop Color="#FFC8CED6" Offset="0.55"/>
        <GradientStop Color="#FFA0A8B2" Offset="0.82"/>
        <GradientStop Color="#FF808890" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道高光：顶部白色反光条 -->
    <LinearGradientBrush x:Key="PipeHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#60FFFFFF" Offset="0.25"/>
        <GradientStop Color="#60FFFFFF" Offset="0.75"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 数据卡片主体：白色微渐变 -->
    <LinearGradientBrush x:Key="DataCardBodyBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFBFBFC" Offset="0.5"/>
        <GradientStop Color="#FFF5F6F8" Offset="1"/>
    </LinearGradientBrush>

    <!-- 数据卡片投影底色 -->
    <SolidColorBrush x:Key="DataCardShadowBrush" Color="#FFD0D5DD"/>

    <!-- 标题栏渐变：白到浅灰 -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF5F6F8" Offset="0.6"/>
        <GradientStop Color="#FFECEEF2" Offset="1"/>
    </LinearGradientBrush>

    <!-- 标题栏顶部高光线：浅蓝灰色横线 -->
    <LinearGradientBrush x:Key="TitleTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A0B0C0" Offset="0"/>
        <GradientStop Color="#40A0B0C0" Offset="0.2"/>
        <GradientStop Color="#60A0B0C0" Offset="0.5"/>
        <GradientStop Color="#40A0B0C0" Offset="0.8"/>
        <GradientStop Color="#00A0B0C0" Offset="1"/>
    </LinearGradientBrush>

    <!-- 扫描线纹理：浅色主题下设为全透明（不可见） -->
    <DrawingBrush x:Key="ScanLineBrush" TileMode="Tile"
                  Viewport="0,0,1,0.0125" ViewportUnits="RelativeToBoundingBox">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#00000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,0.5"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 管道槽外层背景 -->
    <LinearGradientBrush x:Key="PipeOuterSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD8DCE2" Offset="0"/>
        <GradientStop Color="#FFC8CCD4" Offset="0.5"/>
        <GradientStop Color="#FFD8DCE2" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【DropShadowEffect 资源】
         浅色主题下统一使用柔和灰色投影，取消发光
    ══════════════════════════════════════════ -->

    <!-- 设备高亮：柔和蓝色投影（替换原青色发光） -->
    <DropShadowEffect x:Key="CyanGlowEffect"
                      Color="#4A90D9"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Opacity="0.25"/>

    <!-- 正常状态指示：柔和绿色投影 -->
    <DropShadowEffect x:Key="GreenGlowEffect"
                      Color="#48BB78"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Opacity="0.20"/>

    <!-- 标题文字：极淡投影（不再发光） -->
    <DropShadowEffect x:Key="TitleGlowEffect"
                      Color="#000000"
                      BlurRadius="4"
                      ShadowDepth="1"
                      Opacity="0.08"/>

    <!-- 下投影：柔和灰色卡片投影 -->
    <DropShadowEffect x:Key="CardDropShadow"
                      Color="#FF808890"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.15"/>

    <!-- 面板内阴影：柔和灰色 -->
    <DropShadowEffect x:Key="PanelInsetShadow"
                      Color="#FF808890"
                      BlurRadius="4"
                      ShadowDepth="1"
                      Direction="315"
                      Opacity="0.12"/>

    <!-- ══════════════════════════════════════════
         【TextBox 数据卡片样式】
         功能保留：IsReadOnly、Text绑定、Name均不变
         外观：白色卡片 + 左侧蓝灰色边 + 柔和投影
    ══════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground"     Value="#1A365D"/>
        <Setter Property="FontSize"       Value="11"/>
        <Setter Property="TextAlignment"  Value="Center"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- 层1：底部投影（右下偏移2px，制造厚度感） -->
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Margin="2,2,0,0"
                            CornerRadius="3"
                            Background="{StaticResource DataCardShadowBrush}"
                            Opacity="0.50"/>

                        <!-- 层2：左侧彩色立体边（蓝灰色调） -->
                        <Border
                            Width="3"
                            Margin="0,1,0,1"
                            HorizontalAlignment="Left"
                            CornerRadius="2,0,0,2"
                            Opacity="0.9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF5A7DA8" Offset="0"/>
                                    <GradientStop Color="#FF3D5A80" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 层3：主体卡片（白色+浅灰边框） -->
                        <Border
                            Margin="0,0,2,2"
                            CornerRadius="0,3,3,0"
                            BorderThickness="0,0.8,0.8,0"
                            BorderBrush="#30607890"
                            Background="{StaticResource DataCardBodyBrush}">
                            <!-- 层4：顶部高光线 -->
                            <Border
                                BorderThickness="0,0.8,0,0"
                                CornerRadius="0,3,0,0"
                                Margin="0"
                                BorderBrush="#18A0B0C0">
                                <!-- 内容区域 -->
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
