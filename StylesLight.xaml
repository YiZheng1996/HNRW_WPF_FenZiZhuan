<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ═══════════════════════════════════════════════════════════
      分子筛转轮动态测试系统  —  深色工业3D风样式库
      文件：StylesLight.xaml
      说明：深色工业大屏风格，参考沸石转轮工艺图配色
            仅修改外观，不影响任何功能逻辑与数据绑定
    ═══════════════════════════════════════════════════════════
    -->

    <!-- ══════════════════════════════════════════
         【主背景】深色宇宙工业感 - 中心聚光效果
    ══════════════════════════════════════════ -->

    <!-- 主背景：深蓝黑径向渐变，中心略亮，边缘深暗 -->
    <RadialGradientBrush x:Key="MainBackgroundBrush" GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FF1E2840" Offset="0"/>
        <GradientStop Color="#FF141D30" Offset="0.45"/>
        <GradientStop Color="#FF0C1320" Offset="0.75"/>
        <GradientStop Color="#FF080E18" Offset="1"/>
    </RadialGradientBrush>

    <!-- ══════════════════════════════════════════
         【管道配色】金属银灰3D管道（保持工业风）
    ══════════════════════════════════════════ -->

    <!-- 管道槽：深色凹槽底色 -->
    <LinearGradientBrush x:Key="PipeSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF2A2E3A" Offset="0"/>
        <GradientStop Color="#FF1C2030" Offset="0.5"/>
        <GradientStop Color="#FF2A2E3A" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道3D渐变：增强光泽感的金属银灰截面 -->
    <LinearGradientBrush x:Key="Pipe3DBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFA0A8B4" Offset="0"/>
        <GradientStop Color="#FFECEFF4" Offset="0.20"/>
        <GradientStop Color="#FFD0D4DC" Offset="0.50"/>
        <GradientStop Color="#FF9098A4" Offset="0.80"/>
        <GradientStop Color="#FF606870" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道高光：强化顶部白色反光条 -->
    <LinearGradientBrush x:Key="PipeHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.25"/>
        <GradientStop Color="#80FFFFFF" Offset="0.75"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【数据卡片】深色玻璃质感面板
    ══════════════════════════════════════════ -->

    <!-- 数据卡片主体：深色蓝黑渐变（玻璃质感） -->
    <LinearGradientBrush x:Key="DataCardBodyBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF1E2D42" Offset="0"/>
        <GradientStop Color="#FF18253A" Offset="0.5"/>
        <GradientStop Color="#FF111C2E" Offset="1"/>
    </LinearGradientBrush>

    <!-- 数据卡片投影底色：深青色 -->
    <SolidColorBrush x:Key="DataCardShadowBrush" Color="#0A0E1A"/>

    <!-- ══════════════════════════════════════════
         【标题栏】深色金属工业标题
    ══════════════════════════════════════════ -->

    <!-- 标题栏渐变：深蓝到深蓝黑 -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF243050" Offset="0"/>
        <GradientStop Color="#FF1A2440" Offset="0.5"/>
        <GradientStop Color="#FF101830" Offset="1"/>
    </LinearGradientBrush>

    <!-- 标题栏顶部高光线：亮青色/电光蓝 -->
    <LinearGradientBrush x:Key="TitleTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000D4FF" Offset="0"/>
        <GradientStop Color="#6000C8E8" Offset="0.15"/>
        <GradientStop Color="#A000E8FF" Offset="0.5"/>
        <GradientStop Color="#6000C8E8" Offset="0.85"/>
        <GradientStop Color="#0000D4FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【扫描线纹理】工业显示器扫描线效果
    ══════════════════════════════════════════ -->

    <!-- 扫描线：深色主题下细密水平线条，增加HMI质感 -->
    <DrawingBrush x:Key="ScanLineBrush" TileMode="Tile"
                  Viewport="0,0,1,0.005" ViewportUnits="RelativeToBoundingBox"
                  Opacity="0.18">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#14001824">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,0.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0800101C">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0.5,1,0.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 管道槽外层背景 -->
    <LinearGradientBrush x:Key="PipeOuterSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF2E3444" Offset="0"/>
        <GradientStop Color="#FF1E2434" Offset="0.5"/>
        <GradientStop Color="#FF2E3444" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【DropShadowEffect 资源】深色主题增强光效
    ══════════════════════════════════════════ -->

    <!-- 设备高亮：强烈青色发光（深色主题下非常显眼） -->
    <DropShadowEffect x:Key="CyanGlowEffect"
                      Color="#00E5FF"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Opacity="0.55"/>

    <!-- 正常状态：明亮绿色发光 -->
    <DropShadowEffect x:Key="GreenGlowEffect"
                      Color="#00FF80"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.50"/>

    <!-- 标题文字：青色光晕 -->
    <DropShadowEffect x:Key="TitleGlowEffect"
                      Color="#00C8E8"
                      BlurRadius="8"
                      ShadowDepth="0"
                      Opacity="0.60"/>

    <!-- 卡片投影：青蓝色深度阴影（3D立体感） -->
    <DropShadowEffect x:Key="CardDropShadow"
                      Color="#003050"
                      BlurRadius="12"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.70"/>

    <!-- 面板内阴影：深色内嵌 -->
    <DropShadowEffect x:Key="PanelInsetShadow"
                      Color="#00182A"
                      BlurRadius="6"
                      ShadowDepth="2"
                      Direction="315"
                      Opacity="0.60"/>

    <!-- ══════════════════════════════════════════
         【TextBox 数据卡片样式】
         深色玻璃面板 + 左侧青色发光边框 + 3D立体投影
         功能保留：IsReadOnly、Text绑定、Name均不变
    ══════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground"     Value="#00D4FF"/>
        <Setter Property="FontSize"       Value="11"/>
        <Setter Property="TextAlignment"  Value="Center"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- 层1：底部深色投影（右下偏移3px，强化3D厚度感） -->
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Margin="3,3,0,0"
                            CornerRadius="3"
                            Opacity="0.80">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF001828" Offset="0"/>
                                    <GradientStop Color="#FF00101E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 层2：左侧青色发光立体边 -->
                        <Border
                            Width="3"
                            Margin="0,1,0,1"
                            HorizontalAlignment="Left"
                            CornerRadius="2,0,0,2"
                            Opacity="0.95">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF00E5FF" Offset="0"/>
                                    <GradientStop Color="#FF0090C0" Offset="0.5"/>
                                    <GradientStop Color="#FF006890" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>

                        <!-- 层3：主体深色玻璃卡片 + 细边框 -->
                        <Border
                            Margin="0,0,3,3"
                            CornerRadius="0,3,3,0"
                            BorderThickness="0,0.8,0.8,0"
                            BorderBrush="#3000A8CC">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF1E2D42" Offset="0"/>
                                    <GradientStop Color="#FF18253A" Offset="0.5"/>
                                    <GradientStop Color="#FF111C2E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- 层4：顶部青色高光线 -->
                            <Border
                                BorderThickness="0,0.8,0,0"
                                CornerRadius="0,3,0,0"
                                Margin="0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0000D4FF" Offset="0"/>
                                        <GradientStop Color="#5000D4FF" Offset="0.5"/>
                                        <GradientStop Color="#0000D4FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <!-- 内容区域 -->
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
