<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ═══════════════════════════════════════════════════════════
      分子筛转轮动态测试系统  —  浅色专业工业风样式库
      文件：StylesLight.xaml
      说明：灰白背景 + 金属管道 + 专业3D卡片
            仅修改外观，不影响任何功能逻辑与数据绑定
    ═══════════════════════════════════════════════════════════
    -->

    <!-- ══════════════════════════════════════════
         【主背景】珍珠白 + 技术点阵纹理
    ══════════════════════════════════════════ -->

    <!-- 主背景：冷白径向渐变，中心略亮形成自然聚焦 -->
    <RadialGradientBrush x:Key="MainBackgroundBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1.0" RadiusY="1.0">
        <GradientStop Color="#FAF8F5" Offset="0"/>
        <GradientStop Color="#FAF8F5" Offset="0.6"/>
        <GradientStop Color="#FAF8F5" Offset="1"/>
    </RadialGradientBrush>


    <!-- ══════════════════════════════════════════
         【管道配色】金属银灰3D圆管（工程真实感）
    ══════════════════════════════════════════ -->

    <!-- 管道槽：浅灰底色 -->
    <LinearGradientBrush x:Key="PipeSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD0D0D0" Offset="0"/>
        <GradientStop Color="#FFC0C0C0" Offset="0.5"/>
        <GradientStop Color="#FFD0D0D0" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道3D渐变：中灰色金属管 -->
    <LinearGradientBrush x:Key="Pipe3DBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF888888" Offset="0"/>
        <GradientStop Color="#FFB8B8B8" Offset="0.20"/>
        <GradientStop Color="#FF787878" Offset="0.55"/>
        <GradientStop Color="#FF585858" Offset="0.82"/>
        <GradientStop Color="#FF404040" Offset="1"/>
    </LinearGradientBrush>

    <!-- 管道高光：顶部白色反光条 -->
    <LinearGradientBrush x:Key="PipeHighlightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#70FFFFFF" Offset="0.25"/>
        <GradientStop Color="#70FFFFFF" Offset="0.75"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【数据卡片】白色立体卡片（多层深度感）
    ══════════════════════════════════════════ -->

    <!-- 数据卡片主体：纯白 -->
    <LinearGradientBrush x:Key="DataCardBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF8F8F8" Offset="1"/>
    </LinearGradientBrush>

    <!-- 卡片投影：浅灰 -->
    <SolidColorBrush x:Key="DataCardShadowBrush" Color="#FFD0D0D0"/>

    <!-- ══════════════════════════════════════════
         【标题栏】专业工业标题（浅蓝钢色调）
    ══════════════════════════════════════════ -->

    <!-- 标题栏背景 -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF0F0F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- 标题顶线：改为深灰（图片中无彩色装饰线） -->
    <SolidColorBrush x:Key="TitleTopHighlightBrush" Color="#FF505050"/>

    <!-- ══════════════════════════════════════════
         【背景纹理】细密技术点阵（工程图纸感）
    ══════════════════════════════════════════ -->

    <!-- 点阵背景：每20px一个微小网格点，类工程图纸 -->
    <DrawingBrush x:Key="ScanLineBrush" TileMode="Tile"
                  Viewport="0,0,0.025,0.025" ViewportUnits="RelativeToBoundingBox"
                  Opacity="0.55">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#28607898">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="0.5,0.5" RadiusX="0.06" RadiusY="0.06"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 管道槽外层背景 -->
    <LinearGradientBrush x:Key="PipeOuterSlotBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFD8DCE4" Offset="0"/>
        <GradientStop Color="#FFC8CCD6" Offset="0.5"/>
        <GradientStop Color="#FFD8DCE4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════
         【DropShadowEffect 资源】浅色主题精准阴影
    ══════════════════════════════════════════ -->

    <!-- 投影效果：灰色 -->
    <DropShadowEffect x:Key="CyanGlowEffect"
                  Color="#808080"
                  BlurRadius="6"
                  ShadowDepth="2"
                  Opacity="0.4"/>

    <!-- 正常状态：绿色柔和投影 -->
    <DropShadowEffect x:Key="GreenGlowEffect"
                      Color="#2E7D32"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Opacity="0.25"/>

    <!-- 标题文字：极淡灰色（不发光、纯阴影） -->
    <DropShadowEffect x:Key="TitleGlowEffect"
                      Color="#90A8C0"
                      BlurRadius="4"
                      ShadowDepth="1"
                      Opacity="0.20"/>

    <DropShadowEffect x:Key="CardDropShadow"
                  Color="#A0A0A0"
                  BlurRadius="8"
                  ShadowDepth="3"
                  Direction="270"
                  Opacity="0.5"/>

    <!-- 面板内阴影：柔和灰蓝 -->
    <DropShadowEffect x:Key="PanelInsetShadow"
                      Color="#7080A0"
                      BlurRadius="5"
                      ShadowDepth="1"
                      Direction="315"
                      Opacity="0.15"/>

    <!-- ══════════════════════════════════════════
         【TextBox 数据卡片样式】
         白色3D凸起卡片 + 左侧蓝钢竖边 + 多层阴影
         功能保留：IsReadOnly、Text绑定、Name均不变
    ══════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground"     Value="#1A3A5A"/>
        <Setter Property="FontSize"       Value="11"/>
        <Setter Property="TextAlignment"  Value="Center"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- 层1：右下蓝灰投影（厚度感/3D立体底面） -->
                        <Border
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Margin="2,2,0,0"
                            CornerRadius="3"
                            Background="{StaticResource DataCardShadowBrush}"
                            Opacity="0.55"/>

                        <!-- 层2：左侧蓝钢渐变竖边（区域色彩标识） -->
                        <Border
                            Width="3"
                            Margin="0,1,0,1"
                            HorizontalAlignment="Left"
                            CornerRadius="2,0,0,2"
                            Opacity="0.90">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF606060" Offset="0"/>
                                    <GradientStop Color="#FF505050" Offset="0.5"/>
                                    <GradientStop Color="#FF404040" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 层3：主体白色卡片 + 蓝灰细边 -->
                        <Border
                            Margin="0,0,2,2"
                            CornerRadius="0,3,3,0"
                            BorderThickness="0,0.8,0.8,0"
                            BorderBrush="#281565C0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFCFCFE" Offset="0.5"/>
                                    <GradientStop Color="#FFF5F7FB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- 层4：顶部蓝色高光线（3D上边缘高光） -->
                            <Border
                                BorderThickness="0,0.8,0,0"
                                CornerRadius="0,3,0,0"
                                Margin="0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#001565C0" Offset="0"/>
                                        <GradientStop Color="#401976D2" Offset="0.5"/>
                                        <GradientStop Color="#001565C0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <!-- 内容区域 -->
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
